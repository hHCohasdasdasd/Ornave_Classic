generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String                  @id @default(cuid())
  memberNumber               Int                     @unique
  email                      String                  @unique
  password                   String
  firstName                  String
  lastName                   String
  role                       String                  @default("EMPLOYEE")
  userType                   String                  @default("COMPANY_USER")
  isActive                   Boolean                 @default(true)
  companyId                  String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  lastLogin                  DateTime?
  failedLoginAttempts        Int                     @default(0)
  lockedUntil                DateTime?
  lockoutCount               Int                     @default(0)
  permanentlyLocked          Boolean                 @default(false)
  isPlatformAdmin            Boolean                 @default(false)
  emailVerified              Boolean                 @default(false)
  emailVerificationTokenHash String?                 @unique
  emailVerificationExpiry    DateTime?
  payments                   GlobalPayment[]
  globalRequests             GlobalRequest[]
  orders                     Order[]
  posts                      Post[]
  comments                   Comment[]
  postLikes                  PostLike[]
  company                    Company?                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyConnections         UserCompanyConnection[]
  documents                  UserDocument[]
  profile                    UserProfile?
  sentConnections            UserConnection[]        @relation("requester")
  receivedConnections        UserConnection[]        @relation("addressee")
  createdGroups              Group[]
  groupMemberships           GroupMember[]
  publications               Publication[]
  publicationComments        PublicationComment[]
  events                     Event[]
  eventRsvps                 EventRsvp[]
  eventSaves                 EventSave[]
  savedCards                 SavedCard[]
  savedAddresses             SavedAddress[]
  projects                   Project[]
  tasks                      Task[]
  clients                    Client[]
  invoices                   Invoice[]
  goals                      Goal[]
  achievements               Achievement[]
  notes                      Note[]
  files                      UserFile[]
  folders                    UserFolder[]

  @@index([companyId])
  @@index([email])
}

model UserConnection {
  id                 String    @id @default(cuid())
  requesterId        String
  addresseeId        String
  status             String    @default("PENDING")
  partnerStatus      String    @default("NONE")
  partnerRequestedBy String?
  partneredAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  requester          User      @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee          User      @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
  @@index([partnerStatus])
}

model Company {
  id                    String                  @id @default(cuid())
  name                  String
  slug                  String                  @unique
  companyToken          String                  @unique @default(cuid())
  description           String?
  logo                  String?
  isActive              Boolean                 @default(true)
  isPremium             Boolean                 @default(false)
  registrationNumber    String?
  country               String?
  industry              String?
  capabilities          String                  @default("[]")
  isVerified            Boolean                 @default(false)
  isPublicProfile       Boolean                 @default(false)
  verificationToken     String?                 @unique
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  activityEvents        ActivityEvent[]
  connectedFrom         CompanyConnection[]     @relation("to")
  connections           CompanyConnection[]     @relation("from")
  companyProfiles       CompanyProfile?
  settings              CompanySettings?
  connectionPermissions ConnectionPermission[]
  globalPayments        GlobalPayment[]
  globalRequests        GlobalRequest[]
  receivedTransactions  GlobalTransaction[]     @relation("receiver")
  sentTransactions      GlobalTransaction[]     @relation("sender")
  messages              Message[]
  modules               Module[]
  orders                Order[]
  pages                 Page[]
  products              Product[]
  users                 User[]
  userConnections       UserCompanyConnection[]
  userDocuments         UserDocument[]
  publications          Publication[]
  jobs                  Job[]
  deals                 Deal[]
  leads                 Lead[]
  campaigns             Campaign[]
  courses               Course[]
  candidates            Candidate[]
  companyInvoices       CompanyInvoice[]

  @@index([slug])
  @@index([companyToken])
  @@index([isPublicProfile])
  @@index([country])
  @@index([industry])
}

model CompanyProfile {
  id                 String    @id @default(cuid())
  companyId          String    @unique
  about              String?
  website            String?
  industry           String?
  country            String?
  capabilities       String    @default("[]")
  verificationStatus String    @default("UNVERIFIED")
  verificationDate   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([industry])
  @@index([country])
  @@index([verificationStatus])
}

model CompanyConnection {
  id             String                 @id @default(cuid())
  fromCompanyId  String
  toCompanyId    String
  connectionType String                 @default("PARTNER")
  status         String                 @default("PENDING")
  requestMessage String?
  connectedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  toCompany      Company                @relation("to", fields: [toCompanyId], references: [id], onDelete: Cascade)
  fromCompany    Company                @relation("from", fields: [fromCompanyId], references: [id], onDelete: Cascade)
  permissions    ConnectionPermission[]
  transactions   GlobalTransaction[]    @relation("connection")

  @@unique([fromCompanyId, toCompanyId])
  @@index([fromCompanyId])
  @@index([toCompanyId])
  @@index([status])
  @@index([connectionType])
}

model ConnectionPermission {
  id                 String            @id @default(cuid())
  companyId          String
  connectionId       String
  canViewInventory   Boolean           @default(false)
  canCreateOrders    Boolean           @default(false)
  canViewOrders      Boolean           @default(false)
  canCreateInvoices  Boolean           @default(false)
  canViewInvoices    Boolean           @default(false)
  canAccessPricing   Boolean           @default(false)
  canReceiveMessages Boolean           @default(true)
  customPermissions  String            @default("{}")
  grantedAt          DateTime          @default(now())
  expiresAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  connection         CompanyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, connectionId])
  @@index([companyId])
  @@index([connectionId])
}

model GlobalTransaction {
  id                    String            @id @default(cuid())
  fromCompanyId         String
  toCompanyId           String
  connectionId          String
  transactionType       String
  senderReference       String?
  receiverReference     String?           @unique
  globalReference       String            @unique
  status                String            @default("DRAFT")
  senderModuleMapping   String?
  receiverModuleMapping String?
  payload               String            @default("{}")
  statusHistory         String            @default("[]")
  totalAmount           Float?
  currency              String?
  dueDate               DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  connection            CompanyConnection @relation("connection", fields: [connectionId], references: [id])
  toCompany             Company           @relation("receiver", fields: [toCompanyId], references: [id])
  fromCompany           Company           @relation("sender", fields: [fromCompanyId], references: [id], onDelete: Cascade)

  @@index([fromCompanyId])
  @@index([toCompanyId])
  @@index([status])
  @@index([transactionType])
  @@index([connectionId])
}

model ModuleMapping {
  id            String   @id @default(cuid())
  companyId     String
  moduleName    String
  globalObjects String   @default("[]")
  fieldMapping  String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, moduleName])
}

model ActivityEvent {
  id                   String   @id @default(cuid())
  companyId            String
  eventType            String
  title                String
  description          String?
  relatedTransactionId String?
  relatedCompanyId     String?
  isRead               Boolean  @default(false)
  priority             String   @default("NORMAL")
  createdAt            DateTime @default(now())
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([eventType])
  @@index([isRead])
  @@index([createdAt])
}

model CompanySettings {
  id           String   @id @default(cuid())
  companyId    String   @unique
  moduleOrder  String   @default("")
  pageOrder    String   @default("")
  theme        String   @default("light")
  customConfig String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Module {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  slug         String
  description  String?
  isEnabled    Boolean  @default(true)
  displayOrder Int      @default(0)
  icon         String?
  config       String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([displayOrder])
}

model Page {
  id           String   @id @default(cuid())
  companyId    String
  title        String
  slug         String
  description  String?
  isPublished  Boolean  @default(false)
  displayOrder Int      @default(0)
  icon         String?
  layout       String   @default("{}")
  metadata     String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([displayOrder])
}

model Message {
  id            String   @id @default(cuid())
  fromCompanyId String
  toCompanyId   String
  subject       String?
  content       String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  fromCompany   Company  @relation(fields: [fromCompanyId], references: [id], onDelete: Cascade)

  @@index([fromCompanyId])
  @@index([toCompanyId])
  @@index([isRead])
}

model UserProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayName   String?
  phone         String?
  avatarUrl     String?
  bannerUrl     String?
  headline      String?
  address       String?
  streetAddress String?
  city          String?
  state         String?
  postalCode    String?
  country       String?
  preferences   String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bio           String?
  website       String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id                  String       @id @default(cuid())
  authorId            String
  content             String
  mediaUrl            String?
  type                String       @default("post")
  reactions           String       @default("{}")
  visibility          String       @default("public")
  isDeleted           Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  title               String?
  groupId             String?
  linkedPublicationId String?
  mentions            String       @default("[]")
  tags                String       @default("[]")
  author              User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group               Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  linkedPublication   Publication? @relation(fields: [linkedPublicationId], references: [id], onDelete: SetNull)
  comments            Comment[]
  likes               PostLike[]

  @@index([authorId])
  @@index([createdAt])
  @@index([visibility])
  @@index([groupId])
  @@index([linkedPublicationId])
}

// A user-created sector/community (e.g. "Science", "Finance") that both
// individual users and firms can join. Discussions are regular Posts scoped
// to the group via Post.groupId; Publications surface here separately by
// matching their own tags against this group's tag, not through a direct
// relation, so one publication can appear in multiple sector groups at once.
model Group {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  tag         String        @unique
  coverImage  String?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  members     GroupMember[]
  discussions Post[]

  @@index([slug])
  @@index([tag])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

// A longer-form piece a user or firm publishes with sector tags — distinct
// from a Post (own comments/reactions, not part of the home feed). Shows on
// the author's profile and in every Group whose tag appears in `tags`.
model Publication {
  id            String               @id @default(cuid())
  authorId      String
  companyId     String?
  title         String
  content       String
  coverImage    String?
  tags          String               @default("[]")
  mentions      String               @default("[]")
  reactions     String               @default("{}")
  visibility    String               @default("public")
  isDeleted     Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  author        User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  company       Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  comments      PublicationComment[]
  linkedInPosts Post[]

  @@index([authorId])
  @@index([companyId])
  @@index([createdAt])
}

model PublicationComment {
  id            String      @id @default(cuid())
  publicationId String
  authorId      String
  content       String
  createdAt     DateTime    @default(now())
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([publicationId])
  @@index([authorId])
}

model Job {
  id             String   @id @default(cuid())
  companyId      String
  title          String
  location       String?
  type           String   @default("Full-time")
  description    String?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String   @default("USD")
  salaryPeriod   String   @default("year")
  benefits       String? // JSON string array
  qualifications String? // JSON string array
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model UserCompanyConnection {
  id               String   @id @default(cuid())
  userId           String
  companyId        String
  relationshipType String   @default("CLIENT")
  status           String   @default("PENDING")
  permissions      String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([status])
}

model GlobalRequest {
  id                String   @id @default(cuid())
  userId            String
  companyId         String
  type              String
  title             String
  description       String
  metadata          String   @default("{}")
  attachedFiles     String   @default("[]")
  preferredDates    String   @default("[]")
  status            String   @default("OPEN")
  statusHistory     String   @default("[]")
  linkedErpObjectId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([type])
}

model UserDocument {
  id         String   @id @default(cuid())
  userId     String
  companyId  String
  fileUrl    String
  type       String
  visibility String   @default("PRIVATE")
  uploadedBy String   @default("USER")
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([visibility])
}

model GlobalPayment {
  id            String   @id @default(cuid())
  userId        String
  companyId     String
  erpInvoiceId  String?
  amount        Float
  status        String   @default("PENDING")
  paymentMethod String?
  createdAt     DateTime @default(now())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model Product {
  id                  String      @id @default(cuid())
  companyId           String
  name                String
  description         String?
  detailedDescription String?
  price               Float
  currency            String      @default("USD")
  imageUrl            String?
  media               String      @default("[]")
  category            String?
  stock               Int         @default(0)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  orderItems          OrderItem[]
  company             Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ticketedEvents      Event[]

  @@index([companyId])
  @@index([category])
}

model Order {
  id                 String      @id @default(cuid())
  userId             String
  companyId          String
  status             String      @default("PENDING")
  totalAmount        Float
  currency           String      @default("USD")
  billingAddress     String?
  billingCity        String?
  billingState       String?
  billingPostalCode  String?
  billingCountry     String?
  deliveryAddress    String?
  deliveryCity       String?
  deliveryState      String?
  deliveryPostalCode String?
  deliveryCountry    String?
  paymentBrand       String?
  paymentLast4       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  company            Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              OrderItem[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model SavedCard {
  id             String   @id @default(cuid())
  userId         String
  cardholderName String
  brand          String
  last4          String
  expiry         String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedAddress {
  id            String   @id @default(cuid())
  userId        String
  label         String?
  fullName      String
  streetAddress String
  city          String?
  state         String?
  postalCode    String?
  country       String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Work Suite: a lightweight mini-ERP owned directly by the logged-in user
// (personal or company account alike) — projects, tasks, a CRM contact
// list, and invoicing, independent of the company-scoped Module/Page system.
model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([userId])
  @@index([status])
}

// Files: personal cloud storage — each row is metadata for one object
// uploaded to Supabase Storage (storageKey is the path within the bucket).
// folderId null means the file sits at the root of the user's Files.
model UserFile {
  id         String      @id @default(cuid())
  userId     String
  folderId   String?
  name       String
  size       Int
  mimeType   String
  storageKey String      @unique
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder     UserFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([folderId])
}

// A folder is just a grouping of files (and other folders) — parentId null
// means it sits at the root. Deleting a folder cascades to everything inside.
model UserFolder {
  id        String       @id @default(cuid())
  userId    String
  parentId  String?
  name      String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    UserFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  UserFolder[] @relation("FolderChildren")
  files     UserFile[]

  @@index([userId])
  @@index([parentId])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  description String?
  status      String    @default("TODO")
  priority    String    @default("MEDIUM")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

model Client {
  id        String    @id @default(cuid())
  userId    String
  name      String
  email     String?
  phone     String?
  company   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices  Invoice[]

  @@index([userId])
}

model Invoice {
  id            String    @id @default(cuid())
  userId        String
  clientId      String?
  invoiceNumber String
  title         String
  amount        Float
  currency      String    @default("USD")
  status        String    @default("DRAFT")
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clientId])
  @@index([status])
}

// Personal growth tracking — goals with progress, and a log of achievements.
// Scoped to userId like the rest of Work Suite, but this is the part of the
// mini-ERP aimed at individuals developing themselves rather than running a
// business (though nothing stops a company user from using it too).
model Goal {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String?
  status      String    @default("ACTIVE")
  progress    Int       @default(0)
  targetDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String?
  achievedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("NOTE") // NOTE | STICKY | MINDMAP
  title     String?
  content   String
  color     String? // sticky-note background color, or mind-map node accent color
  shape     String? // mind-map node shape: pill | rect | diamond | hexagon
  fontSize  String? // mind-map node text size: sm | md | lg
  posX      Float? // mind-map branch position, relative to the tree's center — null means "not manually placed, use auto layout"
  posY      Float?
  pinned    Boolean  @default(false)
  parentId  String? // MINDMAP branches point at the root/parent node they hang off
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Note?    @relation("NoteBranches", fields: [parentId], references: [id], onDelete: Cascade)
  children  Note[]   @relation("NoteBranches")

  @@index([userId])
  @@index([parentId])
}

model Event {
  id                  String      @id @default(cuid())
  authorId            String
  title               String
  description         String?
  detailedDescription String?
  coverImage          String?
  media               String      @default("[]")
  category            String?
  startAt             DateTime
  endAt               DateTime?
  isVirtual           Boolean     @default(false)
  location            String?
  mapUrl              String?
  externalLink        String?
  price               Float       @default(0)
  currency            String      @default("USD")
  capacity            Int?
  ticketProductId     String?
  isPromoted          Boolean     @default(false)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  author              User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ticketProduct       Product?    @relation(fields: [ticketProductId], references: [id], onDelete: SetNull)
  rsvps               EventRsvp[]
  saves               EventSave[]

  @@index([authorId])
  @@index([category])
  @@index([startAt])
  @@index([isPromoted])
}

model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("GOING")
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model EventSave {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// ============================================
// COMPANY ERP MODULES (Sales / Leads / Marketing / Learning / Talent / Billing)
// Every model below is strictly scoped to a single companyId. All access to
// these records must go through routes that verify req.user.companyId
// matches the :companyId route param (see companyContextMiddleware) — one
// company must never be able to read or write another company's ERP data.
// ============================================

model Deal {
  id            String    @id @default(cuid())
  companyId     String
  name          String
  clientCompany String?
  value         Float     @default(0)
  stage         String    @default("Prospect")
  owner         String?
  closeDate     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Lead {
  id                String   @id @default(cuid())
  companyId         String
  name              String
  title             String?
  leadCompany       String?
  location          String?
  industry          String?
  connections       Int      @default(0)
  mutualConnections String?
  saved             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Campaign {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  type        String   @default("Sponsored Content")
  status      String   @default("Draft")
  budget      Float    @default(0)
  spent       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Course {
  id         String   @id @default(cuid())
  companyId  String
  title      String
  instructor String?
  category   String?
  level      String   @default("Beginner")
  duration   String?
  rating     Float    @default(0)
  enrolled   Int      @default(0)
  progress   Int?
  saved      Boolean  @default(false)
  thumbnail  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Candidate {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  title        String?
  location     String?
  skills       String   @default("[]")
  experience   String?
  availability String   @default("Available")
  saved        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyInvoice {
  id          String   @id @default(cuid())
  companyId   String
  description String
  amount      Float
  status      String   @default("Pending")
  invoiceDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Append-only security audit trail for authentication events. Deliberately
// has no FK/cascade relation to User — an audit log should survive account
// deletion, not disappear with it.
model AuthAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  eventType String // 'REGISTER' | 'LOGIN_SUCCESS' | 'LOGIN_FAILED' | 'ACCOUNT_LOCKED' | 'PASSWORD_CHANGED'
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([eventType])
  @@index([createdAt])
}
