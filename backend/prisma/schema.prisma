generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String                  @id @default(cuid())
  memberNumber               Int                     @unique
  email                      String                  @unique
  password                   String
  firstName                  String
  lastName                   String
  role                       String                  @default("EMPLOYEE")
  userType                   String                  @default("COMPANY_USER")
  isActive                   Boolean                 @default(true)
  companyId                  String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  lastLogin                  DateTime?
  failedLoginAttempts        Int                     @default(0)
  lockedUntil                DateTime?
  lockoutCount               Int                     @default(0)
  permanentlyLocked          Boolean                 @default(false)
  isPlatformAdmin            Boolean                 @default(false)
  emailVerified              Boolean                 @default(false)
  emailVerificationTokenHash String?                 @unique
  emailVerificationExpiry    DateTime?
  passwordResetTokenHash     String?                 @unique
  passwordResetExpiry        DateTime?
  deletedAt                  DateTime?
  // Set once AccountPurgeService has hard-deleted this account's personal
  // content (30 days after deletedAt) — makes the purge idempotent. The
  // anonymized User row itself is kept forever so Orders/etc. tied to other
  // parties stay valid.
  purgedAt                   DateTime?
  // Inert until real billing exists — the purge job skips accounts flagged
  // active here rather than deleting a paying member's data out from under
  // them. Nothing sets this true yet.
  subscriptionActive         Boolean                 @default(false)
  // The Stripe Customer this user's saved payment methods (cards, linked
  // bank accounts) live under. Created lazily on first "Add payment method".
  stripeCustomerId           String?                 @unique
  // Purchasable profile status — 'BASIC' | 'BRONZE' | 'SILVER' | 'GOLD' |
  // 'DIAMOND'. BASIC is free/default; everything above it is a real
  // recurring Stripe subscription (see MembershipService).
  memberTier                 String                  @default("BASIC")
  memberTierSubscriptionId   String?                 @unique
  // When the current paid subscription started — anchors the 3-month
  // minimum commitment on Silver/Gold/Diamond (Bronze has none). Reset
  // every time a new paid checkout completes.
  memberTierStartedAt        DateTime?
  // 'MONTHLY' (recurring Stripe subscription) | 'ANNUAL' (one-time payment
  // for 12 months, no auto-renewal — reverts to BASIC automatically once
  // the year is up). Null for BASIC. Silver/Gold/Diamond only; Bronze is
  // monthly-only.
  memberTierBillingPeriod    String?
  // Set when a monthly Silver+ member cancels while still inside the
  // 3-month minimum — the cancellation is accepted and scheduled for this
  // date (mirrored as Stripe's subscription `cancel_at`) rather than
  // blocked outright, so canceling is never harder than subscribing was.
  // Cleared on undo, on the scheduled date actually arriving (webhook), or
  // if the member buys into a different tier before then.
  memberTierCancelAt         DateTime?
  // The one-time "Verified" badge add-on — separate from memberTier since
  // Silver and above include it for free, but it can also be bought alone.
  isVerified                 Boolean                 @default(false)
  twoFactorEnabled           Boolean                 @default(false)
  twoFactorSecret            String?
  twoFactorBackupCodesHash   String?
  payments                   GlobalPayment[]
  globalRequests             GlobalRequest[]
  orders                     Order[]
  posts                      Post[]
  comments                   Comment[]
  postLikes                  PostLike[]
  company                    Company?                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyConnections         UserCompanyConnection[]
  documents                  UserDocument[]
  profile                    UserProfile?
  sentConnections            UserConnection[]        @relation("requester")
  receivedConnections        UserConnection[]        @relation("addressee")
  createdGroups              Group[]
  groupMemberships           GroupMember[]
  publications               Publication[]
  publicationComments        PublicationComment[]
  events                     Event[]
  eventRsvps                 EventRsvp[]
  eventSaves                 EventSave[]
  savedCards                 SavedCard[]
  savedBankAccounts          SavedBankAccount[]
  savedAddresses             SavedAddress[]
  projects                   Project[]
  tasks                      Task[]
  goals                      Goal[]
  achievements               Achievement[]
  jobApplications            JobApplication[]
  workProfile                WorkProfile?
  calendarEvents              CalendarEvent[]
  financeEntries              FinanceEntry[]
  manualOrders                ManualOrder[]
  bankConnections              BankConnection[]
  notes                      Note[]
  files                      UserFile[]
  folders                    UserFolder[]
  focusSessions              FocusSession[]
  focusWorkMinutes           Int                     @default(25)
  focusBreakMinutes          Int                     @default(5)
  sentDirectMessages         DirectMessage[]         @relation("sentDirectMessages")
  receivedDirectMessages     DirectMessage[]         @relation("receivedDirectMessages")
  notifications              Notification[]
  tableReservations          TableReservation[]
  checkInProfile             CheckInProfile?

  @@index([companyId])
  @@index([email])
}

model UserConnection {
  id                 String    @id @default(cuid())
  requesterId        String
  addresseeId        String
  status             String    @default("PENDING")
  partnerStatus      String    @default("NONE")
  partnerRequestedBy String?
  partneredAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  requester          User      @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee          User      @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
  @@index([partnerStatus])
}

model Company {
  id                    String                  @id @default(cuid())
  name                  String
  slug                  String                  @unique
  companyToken          String                  @unique @default(cuid())
  description           String?
  logo                  String?
  bannerUrl             String?
  isActive              Boolean                 @default(true)
  isPremium             Boolean                 @default(false)
  registrationNumber    String?
  country               String?
  industry              String?
  capabilities          String                  @default("[]")
  isVerified            Boolean                 @default(false)
  isPublicProfile       Boolean                 @default(false)
  verificationToken     String?                 @unique
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  activityEvents        ActivityEvent[]
  connectedFrom         CompanyConnection[]     @relation("to")
  connections           CompanyConnection[]     @relation("from")
  companyProfiles       CompanyProfile?
  settings              CompanySettings?
  connectionPermissions ConnectionPermission[]
  globalPayments        GlobalPayment[]
  globalRequests        GlobalRequest[]
  receivedTransactions  GlobalTransaction[]     @relation("receiver")
  sentTransactions      GlobalTransaction[]     @relation("sender")
  messages              Message[]
  modules               Module[]
  orders                Order[]
  pages                 Page[]
  products              Product[]
  users                 User[]
  userConnections       UserCompanyConnection[]
  userDocuments         UserDocument[]
  publications          Publication[]
  jobs                  Job[]
  deals                 Deal[]
  leads                 Lead[]
  campaigns             Campaign[]
  courses               Course[]
  candidates            Candidate[]
  companyInvoices       CompanyInvoice[]
  menuItems             MenuItem[]
  restaurantTables      RestaurantTable[]
  floorPlanWalls        FloorPlanWall[]
  floorPlanChairs       FloorPlanChair[]
  tableReservations     TableReservation[]
  barTabs               BarTab[]
  barStools             BarStool[]
  terminalReaders       TerminalReader[]

  // Stripe Connect — lets the company take real card payments (Terminal
  // card-reader charges, and eventually online payments) with the money
  // settling to their own bank account rather than ours. Express accounts,
  // same onboarding flow used across the industry for platforms like this.
  stripeConnectAccountId        String?  @unique
  stripeConnectDetailsSubmitted Boolean  @default(false)
  stripeConnectChargesEnabled   Boolean  @default(false)
  stripeConnectPayoutsEnabled   Boolean  @default(false)
  // One Terminal Location per company — required by Stripe before any
  // reader can be registered to it. Created lazily on first reader setup.
  terminalLocationId            String?

  @@index([slug])
  @@index([companyToken])
  @@index([isPublicProfile])
  @@index([country])
  @@index([industry])
}

model CompanyProfile {
  id                 String    @id @default(cuid())
  companyId          String    @unique
  about              String?
  website            String?
  industry           String?
  country            String?
  capabilities       String    @default("[]")
  verificationStatus String    @default("UNVERIFIED")
  verificationDate   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([industry])
  @@index([country])
  @@index([verificationStatus])
}

// Restaurant-layout companies manage these from Work Suite; they're what
// actually populates the "Menu" tab on the company's public profile,
// replacing what used to be identical placeholder items for every
// restaurant. Price is a display string (e.g. "$12") rather than a number
// since menus commonly show non-numeric prices ("Market Price", "MP").
model MenuItem {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  price       String
  category    String   @default("Mains")
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  // 'KITCHEN' | 'BAR' — which display an order for this dish/drink shows up
  // on. Explicit rather than inferred from category (a free-text field a
  // restaurant might use inconsistently) so the split is always correct.
  station     String   @default("KITCHEN")
  // Optional — a dish/drink photo shown on the public menu, the QR
  // ordering page, and Server Orders. Signed URLs are minted fresh from
  // this key wherever the item is listed, same pattern as every other
  // private file in this app.
  imageStorageKey String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderItems  TableOrderItem[]
  barTabItems BarTabItem[]

  @@index([companyId])
}

// A bar tab — deliberately not tied to a floor-plan table/seat, unlike
// TableReservation. Some restaurants' bars run as a walk-up counter where a
// bartender starts a tab under a name and closes it out whenever the
// customer's done, with no seating assignment at all. Mirrors
// TableReservation's billing fields (discount/service charge/payment) and
// TableOrderItem/TableOrderCheck's split-check shape, just without the
// table/reservation-time/party-size concepts that don't apply here.
model BarTab {
  id                 String    @id @default(cuid())
  companyId          String
  // Set when a tab is started from clicking a stool on the seating chart
  // rather than the name-only "+ New Tab" flow — lets the Bar module show
  // that stool as occupied and jump straight back into this tab. Null for
  // a walk-up tab that was never tied to a specific seat.
  stoolId            String?
  label              String
  // 'OPEN' | 'CLOSED' | 'CANCELLED'
  status             String    @default("OPEN")
  discountType       String?
  discountValue      Float?
  discountLabel      String?
  serviceChargeType  String?
  serviceChargeValue Float?
  paymentStatus      String    @default("UNPAID")
  paymentMethod      String?
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stool              BarStool? @relation(fields: [stoolId], references: [id], onDelete: SetNull)
  items              BarTabItem[]
  checks             BarTabCheck[]

  @@index([companyId])
  @@index([stoolId])
}

// A sub-bill within one tab, created only when staff use Split Check — same
// reasoning as TableOrderCheck.
model BarTabCheck {
  id                 String   @id @default(cuid())
  tabId              String
  label              String   @default("Check")
  discountType       String?
  discountValue      Float?
  discountLabel      String?
  serviceChargeType  String?
  serviceChargeValue Float?
  paymentStatus      String   @default("UNPAID")
  paymentMethod      String?
  paidAt             DateTime?
  createdAt          DateTime @default(now())
  tab                BarTab   @relation(fields: [tabId], references: [id], onDelete: Cascade)
  items              BarTabItem[]

  @@index([tabId])
}

// One ordered drink — name/price snapshotted at order time, same reasoning
// as TableOrderItem.
model BarTabItem {
  id         String    @id @default(cuid())
  tabId      String
  checkId    String?
  menuItemId String?
  name       String
  price      String
  quantity   Int       @default(1)
  note       String?
  // 'NEW' -> 'PREPARING' -> 'READY' -> 'SERVED', same lifecycle as
  // TableOrderItem — a tab's items show up on the shared Bar ticket board
  // (KitchenService.listForStation) right alongside table/QR orders so
  // they actually get made, not just billed. 'VOID' is the separate
  // terminal state for a wrong pour or sent-back drink.
  status     String    @default("NEW")
  voidReason String?
  voidedAt   DateTime?
  // Set the first time this ticket is printed, same purpose as
  // TableOrderItem.printedAt (Auto-Print skip + "printed" mark on the
  // ticket board) — unrelated to the guest-facing receipt print in Bar
  // Orders itself.
  printedAt  DateTime?
  createdAt  DateTime  @default(now())
  tab        BarTab      @relation(fields: [tabId], references: [id], onDelete: Cascade)
  check      BarTabCheck? @relation(fields: [checkId], references: [id], onDelete: SetNull)
  menuItem   MenuItem?    @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([tabId])
  @@index([checkId])
}

// One ordered dish/drink, placed by a guest from the public table-side
// ordering page (reached via the QR code on their table) and tied to
// whichever reservation is currently active at that table. Deliberately no
// separate "TableOrder" header/open-close state — a reservation's order is
// just "all the TableOrderItem rows under it", so a guest can keep adding
// items across multiple rounds without anything needing to track when a
// round starts or ends. name/price are snapshotted at order time so a menu
// price change later doesn't retroactively alter a bill already run.
model TableOrderItem {
  id            String   @id @default(cuid())
  reservationId String
  menuItemId    String?
  name          String
  price         String
  quantity      Int      @default(1)
  note          String?
  // Snapshotted from MenuItem.station at order time, same reasoning as
  // name/price — a dish moved from Kitchen to Bar later shouldn't
  // retroactively reclassify an order already in someone's queue.
  station       String   @default("KITCHEN")
  // 'NEW' -> 'PREPARING' -> 'READY' -> 'SERVED', advanced by kitchen/bar
  // staff on the station display; 'VOID' is a separate terminal state set
  // by Check Functions, not part of that progression — voided items are
  // kept (not deleted) with a reason, but drop out of Kitchen/Bar and the
  // bill total.
  status        String   @default("NEW")
  voidReason    String?
  voidedAt      DateTime?
  // Set once the order has been split into separate checks (Check
  // Functions -> Split Check) — which check this item belongs to. Null
  // means "the whole/unsplit order," the common case.
  checkId       String?
  // Set the first time this ticket is printed — lets Auto-Print skip
  // anything already sent to the printer instead of reprinting it on every
  // poll refresh, and lets the UI show a "Printed" mark either way.
  printedAt     DateTime?
  createdAt     DateTime @default(now())
  reservation   TableReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  menuItem      MenuItem?        @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  check         TableOrderCheck? @relation(fields: [checkId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([checkId])
}

// A sub-bill within one table's order, created only when staff actually use
// "Split Check" — most tables never have one of these, and pay/discount/
// service-charge at the TableReservation level instead (see there). Each
// check tracks its own discount/service charge/payment so splitting a table
// two ways lets each party pay separately.
model TableOrderCheck {
  id                 String   @id @default(cuid())
  reservationId      String
  label              String   @default("Check")
  discountType       String?
  discountValue      Float?
  discountLabel      String?
  serviceChargeType  String?
  serviceChargeValue Float?
  paymentStatus      String   @default("UNPAID")
  paymentMethod      String?
  paidAt             DateTime?
  createdAt          DateTime @default(now())
  reservation        TableReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  items              TableOrderItem[]

  @@index([reservationId])
}

// One row per company+station — lets each of Kitchen/Bar/Reservations pick
// its own print method and (Kitchen/Bar only) whether tickets print
// automatically as orders arrive, independent of the others (a place with
// only one printer might want Kitchen on auto-print and Bar left manual).
model StationPrinterSettings {
  id          String   @id @default(cuid())
  companyId   String
  // 'KITCHEN' | 'BAR' | 'RESERVATIONS'
  station     String
  // 'USB' (direct ESC/POS thermal printer via WebUSB) | 'BROWSER' (the
  // browser's own print dialog, receipt-width layout).
  printMethod String   @default("BROWSER")
  // Only meaningful for KITCHEN/BAR — Reservations printing is always a
  // manual "Print Receipt" action, never automatic.
  autoPrint   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([companyId, station])
}

// One row per company — where the Server Orders screen's function buttons
// (Check Functions, Discounts, Service Charges, Payments, Print, Send) are
// freely positioned, set up via that page's "Edit Page" layout editor.
// Stored as a JSON string (positions keyed by button id) rather than a
// dedicated column per button, same reasoning as MenuItem.price being
// free-text — the button set itself could grow later without a migration.
model PosLayoutSettings {
  id        String   @id @default(cuid())
  companyId String   @unique
  layout    String
  updatedAt DateTime @updatedAt
}

// One row per company — custom lines a company wants printed on every
// receipt/ticket (address, phone, a thank-you note, return policy, etc.),
// on top of whatever page-specific content (table name, items, totals)
// usePrinter's print() already builds. Free text, one line per newline,
// same reasoning as MenuItem.price being free-text rather than structured.
model ReceiptSettings {
  id         String   @id @default(cuid())
  companyId  String   @unique
  headerText String   @default("")
  footerText String   @default("")
  updatedAt  DateTime @updatedAt
}

// A physical Stripe Terminal card reader registered to this company's
// Terminal Location — the counterpart to Payments' "Card Reader" option
// when Stripe Connect is set up. Mirrors Stripe's own reader object
// (label/status) rather than duplicating everything Stripe already tracks.
model TerminalReader {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stripeReaderId String   @unique
  label          String
  deviceType     String
  status         String   @default("offline")
  createdAt      DateTime @default(now())

  @@index([companyId])
}

// A restaurant-layout company's floor plan — tables placed on a canvas
// (positionX/Y, in the same arbitrary pixel space the frontend canvas
// uses) with a live status for front-of-house use. Internal-only, unlike
// MenuItem — a floor plan isn't shown on the public profile.
model RestaurantTable {
  id          String   @id @default(cuid())
  companyId   String
  label       String
  seats       Int      @default(2)
  shape       String   @default("round")
  status      String   @default("AVAILABLE")
  positionX   Int      @default(0)
  positionY   Int      @default(0)
  // Drag-to-resize on the canvas — defaults match the old fixed per-shape
  // CSS sizes, but from here on width/height are the source of truth.
  width       Int      @default(90)
  height      Int      @default(90)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reservations TableReservation[]

  @@index([companyId])
}

// A customer's date/time booking of a specific table, made from the public
// profile's Reservation tab. Kept separate from RestaurantTable.status
// (which the restaurant staff cycle by hand in the editor for walk-in/live
// floor state) since a table can be AVAILABLE right now but still have
// reservations booked for later.
// A small, purpose-built profile for Automatic Check-In — deliberately
// separate from the general UserProfile (which has marketing-oriented
// fields like a banner photo and website that have nothing to do with
// confirming who someone is). Completing this is one of the three hard
// gates in AutoCheckInService.getEligibility; PlaidService.verifyBankAccount
// also prefers these legal names over User.firstName/lastName when present,
// since they're the ones the user explicitly confirmed for identity checks.
model CheckInProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  legalFirstName String?
  legalLastName  String?
  phone          String?
  email          String?
  // Free-text, shown to restaurant staff when this user's reservation
  // auto-checks-in — e.g. dietary restrictions/allergies ("peanut
  // allergy"). Optional: unlike the other fields, nothing meaningful is
  // being verified here, so it doesn't gate completeness.
  notes          String?
  // ID-style headshot, required (alongside legal name/phone/email) before
  // Automatic Check-In counts as eligible — restaurant staff need to be
  // able to actually recognize who they're looking for. Stored as a
  // private-bucket storage key (see FILES_BUCKET), not a public URL; every
  // read path mints a short-lived signed URL on demand.
  photoStorageKey String?
  // An opaque random token written onto a physical NFC tag/card via Web
  // NFC (Chrome on Android only — see PROFILE_EDIT's "Write NFC Card").
  // Tapping that tag against a compatible kiosk reads this token back and
  // looks the guest up — a real "card read", not a QR/name search, for the
  // devices that can actually do it. Null until the user writes a card.
  nfcToken       String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TableReservation {
  id              String   @id @default(cuid())
  tableId         String
  companyId       String
  // Null for a walk-in a server started from the floor plan — there's no
  // guest account to attach in that case, so walkInName/walkInPhone (jotted
  // down by staff, optional) stand in for it instead.
  userId          String?
  walkInName      String?
  walkInPhone     String?
  partySize       Int      @default(2)
  reservationTime DateTime
  note            String?
  // 'CONFIRMED' | 'CANCELLED' — cancelled rows are kept (not deleted) so a
  // user's reservation history stays intact, and so the slot they freed up
  // is unambiguous from the audit trail.
  status          String   @default("CONFIRMED")
  // Opt-in, gated behind a complete profile + SILVER-or-above tier + a
  // verified bank account (see AutoCheckInService) — when on, a background
  // sweep flips this reservation to checked-in on its own once
  // reservationTime passes, no staff/user action needed.
  autoCheckInEnabled Boolean   @default(false)
  checkedInAt        DateTime?
  // Billing — only meaningful when the order hasn't been split into
  // multiple TableOrderCheck rows; once split, each check carries its own
  // discount/service charge/payment instead. 'PERCENT' | 'FIXED'.
  discountType       String?
  discountValue      Float?
  discountLabel      String?
  serviceChargeType  String?
  serviceChargeValue Float?
  // 'UNPAID' | 'PAID'. Recording payment (unsplit case) also flips status
  // to 'CLOSED' below, which is what actually frees the table.
  paymentStatus      String    @default("UNPAID")
  paymentMethod      String?
  paidAt             DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  table           RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  calendarEvent   CalendarEvent?
  orderItems      TableOrderItem[]
  checks          TableOrderCheck[]

  @@index([tableId])
  @@index([companyId])
  @@index([userId])
}

// A chair placed on the floor plan — deliberately minimal (no seats/status
// of its own, unlike RestaurantTable) since it's just a seating marker
// around a table, not a bookable unit in itself.
model FloorPlanChair {
  id        String   @id @default(cuid())
  companyId String
  positionX Int      @default(0)
  positionY Int      @default(0)
  rotation  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Bar seating — placed freely on the floor plan (not snapped to a table,
// unlike FloorPlanChair against dining tables) since a bar counter isn't a
// table itself. Its own model rather than a FloorPlanChair variant because
// the Bar module reads these directly to show a seating chart — a plain
// chair carries no meaning there. Deliberately no seat/status of its own,
// same reasoning as FloorPlanChair: it's a visual seating count, not
// wired to tabs.
model BarStool {
  id        String   @id @default(cuid())
  companyId String
  // A stool is its own seat at the bar — numbered the same way a table
  // gets a label, so staff/the seating chart can refer to "Stool 3" the
  // same way they'd say "Table 3".
  label     String   @default("Stool")
  positionX Int      @default(0)
  positionY Int      @default(0)
  rotation  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tabs      BarTab[]

  @@index([companyId])
}

// One straight line segment of a hand-sketched floor plan wall — a real
// architect-style outline is just many of these end to end, drawn freehand
// on the canvas rather than dropped from a fixed shape palette. Coordinates
// are the same arbitrary pixel space RestaurantTable's positionX/Y use.
model FloorPlanWall {
  id        String   @id @default(cuid())
  companyId String
  // "line" uses x1/y1 -> x2/y2 as the two endpoints. "circle" uses x1/y1 as
  // the center (x2/y2 just mirror the center, unused) and radius for size —
  // a round booth, curved bar counter, or alcove sketched compass-style.
  shape     String   @default("line")
  x1        Int
  y1        Int
  x2        Int
  y2        Int
  radius    Int?
  // Quadratic-bezier control point, "line" shape only — null means still a
  // plain straight segment. Set once someone drags the curve handle away
  // from the segment's midpoint (see the Curve tool on the floor plan).
  curveX    Int?
  curveY    Int?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyConnection {
  id             String                 @id @default(cuid())
  fromCompanyId  String
  toCompanyId    String
  connectionType String                 @default("PARTNER")
  status         String                 @default("PENDING")
  requestMessage String?
  connectedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  toCompany      Company                @relation("to", fields: [toCompanyId], references: [id], onDelete: Cascade)
  fromCompany    Company                @relation("from", fields: [fromCompanyId], references: [id], onDelete: Cascade)
  permissions    ConnectionPermission[]
  transactions   GlobalTransaction[]    @relation("connection")

  @@unique([fromCompanyId, toCompanyId])
  @@index([fromCompanyId])
  @@index([toCompanyId])
  @@index([status])
  @@index([connectionType])
}

model ConnectionPermission {
  id                 String            @id @default(cuid())
  companyId          String
  connectionId       String
  canViewInventory   Boolean           @default(false)
  canCreateOrders    Boolean           @default(false)
  canViewOrders      Boolean           @default(false)
  canCreateInvoices  Boolean           @default(false)
  canViewInvoices    Boolean           @default(false)
  canAccessPricing   Boolean           @default(false)
  canReceiveMessages Boolean           @default(true)
  customPermissions  String            @default("{}")
  grantedAt          DateTime          @default(now())
  expiresAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  connection         CompanyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, connectionId])
  @@index([companyId])
  @@index([connectionId])
}

model GlobalTransaction {
  id                    String            @id @default(cuid())
  fromCompanyId         String
  toCompanyId           String
  connectionId          String
  transactionType       String
  senderReference       String?
  receiverReference     String?           @unique
  globalReference       String            @unique
  status                String            @default("DRAFT")
  senderModuleMapping   String?
  receiverModuleMapping String?
  payload               String            @default("{}")
  statusHistory         String            @default("[]")
  totalAmount           Float?
  currency              String?
  dueDate               DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  connection            CompanyConnection @relation("connection", fields: [connectionId], references: [id])
  toCompany             Company           @relation("receiver", fields: [toCompanyId], references: [id])
  fromCompany           Company           @relation("sender", fields: [fromCompanyId], references: [id], onDelete: Cascade)

  @@index([fromCompanyId])
  @@index([toCompanyId])
  @@index([status])
  @@index([transactionType])
  @@index([connectionId])
}

model ModuleMapping {
  id            String   @id @default(cuid())
  companyId     String
  moduleName    String
  globalObjects String   @default("[]")
  fieldMapping  String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, moduleName])
}

model ActivityEvent {
  id                   String   @id @default(cuid())
  companyId            String
  eventType            String
  title                String
  description          String?
  relatedTransactionId String?
  relatedCompanyId     String?
  isRead               Boolean  @default(false)
  priority             String   @default("NORMAL")
  createdAt            DateTime @default(now())
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([eventType])
  @@index([isRead])
  @@index([createdAt])
}

model CompanySettings {
  id           String   @id @default(cuid())
  companyId    String   @unique
  moduleOrder  String   @default("")
  pageOrder    String   @default("")
  theme        String   @default("light")
  customConfig String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Module {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  slug         String
  description  String?
  isEnabled    Boolean  @default(true)
  displayOrder Int      @default(0)
  icon         String?
  config       String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([displayOrder])
}

model Page {
  id           String   @id @default(cuid())
  companyId    String
  title        String
  slug         String
  description  String?
  isPublished  Boolean  @default(false)
  displayOrder Int      @default(0)
  icon         String?
  layout       String   @default("{}")
  metadata     String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([displayOrder])
}

model Message {
  id            String   @id @default(cuid())
  fromCompanyId String
  toCompanyId   String
  subject       String?
  content       String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  fromCompany   Company  @relation(fields: [fromCompanyId], references: [id], onDelete: Cascade)

  @@index([fromCompanyId])
  @@index([toCompanyId])
  @@index([isRead])
}

model UserProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayName   String?
  phone         String?
  avatarUrl     String?
  bannerUrl     String?
  headline      String?
  address       String?
  streetAddress String?
  city          String?
  state         String?
  postalCode    String?
  country       String?
  preferences   String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bio           String?
  website       String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id                  String       @id @default(cuid())
  authorId            String
  content             String
  mediaUrl            String?
  type                String       @default("post")
  reactions           String       @default("{}")
  visibility          String       @default("public")
  isDeleted           Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  title               String?
  groupId             String?
  linkedPublicationId String?
  mentions            String       @default("[]")
  tags                String       @default("[]")
  author              User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group               Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  linkedPublication   Publication? @relation(fields: [linkedPublicationId], references: [id], onDelete: SetNull)
  comments            Comment[]
  likes               PostLike[]

  @@index([authorId])
  @@index([createdAt])
  @@index([visibility])
  @@index([groupId])
  @@index([linkedPublicationId])
}

// A user-created sector/community (e.g. "Science", "Finance") that both
// individual users and firms can join. Discussions are regular Posts scoped
// to the group via Post.groupId; Publications surface here separately by
// matching their own tags against this group's tag, not through a direct
// relation, so one publication can appear in multiple sector groups at once.
model Group {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  tag         String        @unique
  coverImage  String?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  members     GroupMember[]
  discussions Post[]

  @@index([slug])
  @@index([tag])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

// A longer-form piece a user or firm publishes with sector tags — distinct
// from a Post (own comments/reactions, not part of the home feed). Shows on
// the author's profile and in every Group whose tag appears in `tags`.
model Publication {
  id            String               @id @default(cuid())
  authorId      String
  companyId     String?
  title         String
  content       String
  coverImage    String?
  tags          String               @default("[]")
  mentions      String               @default("[]")
  reactions     String               @default("{}")
  visibility    String               @default("public")
  isDeleted     Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  author        User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  company       Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  comments      PublicationComment[]
  linkedInPosts Post[]

  @@index([authorId])
  @@index([companyId])
  @@index([createdAt])
}

model PublicationComment {
  id            String      @id @default(cuid())
  publicationId String
  authorId      String
  content       String
  createdAt     DateTime    @default(now())
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([publicationId])
  @@index([authorId])
}

model Job {
  id             String   @id @default(cuid())
  companyId      String
  title          String
  location       String?
  type           String   @default("Full-time")
  description    String?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String   @default("USD")
  salaryPeriod   String   @default("year")
  benefits       String? // JSON string array
  qualifications String? // JSON string array
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model UserCompanyConnection {
  id               String     @id @default(cuid())
  userId           String
  companyId        String
  relationshipType String     @default("CLIENT")
  status           String     @default("PENDING")
  permissions      String     @default("{}")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  company          Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  files            UserFile[]
  messages         ConnectionMessage[]
  tickets          Ticket[]

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([status])
}

// A direct message thread between a user and a firm they're connected to,
// independent of any specific order.
model ConnectionMessage {
  id              String             @id @default(cuid())
  connectionId    String
  senderIsCompany Boolean
  content         String
  createdAt       DateTime           @default(now())
  connection      UserCompanyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
}

// A support ticket a buyer opens with a connected firm — always
// buyer-initiated, tracked to resolution, distinct from the freeform
// ConnectionMessage thread.
model Ticket {
  id           String                @id @default(cuid())
  connectionId String
  subject      String
  status       String                @default("OPEN")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  connection   UserCompanyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  messages     TicketMessage[]

  @@index([connectionId])
  @@index([status])
}

model TicketMessage {
  id              String   @id @default(cuid())
  ticketId        String
  senderIsCompany Boolean
  content         String
  createdAt       DateTime @default(now())
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model GlobalRequest {
  id                String   @id @default(cuid())
  userId            String
  companyId         String
  type              String
  title             String
  description       String
  metadata          String   @default("{}")
  attachedFiles     String   @default("[]")
  preferredDates    String   @default("[]")
  status            String   @default("OPEN")
  statusHistory     String   @default("[]")
  linkedErpObjectId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([type])
}

model UserDocument {
  id         String   @id @default(cuid())
  userId     String
  companyId  String
  fileUrl    String
  type       String
  visibility String   @default("PRIVATE")
  uploadedBy String   @default("USER")
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([visibility])
}

model GlobalPayment {
  id            String   @id @default(cuid())
  userId        String
  companyId     String
  erpInvoiceId  String?
  amount        Float
  status        String   @default("PENDING")
  paymentMethod String?
  createdAt     DateTime @default(now())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model Product {
  id                  String      @id @default(cuid())
  companyId           String
  name                String
  description         String?
  detailedDescription String?
  price               Float
  currency            String      @default("USD")
  imageUrl            String?
  media               String      @default("[]")
  category            String?
  stock               Int         @default(0)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  orderItems          OrderItem[]
  company             Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ticketedEvents      Event[]

  @@index([companyId])
  @@index([category])
}

model Order {
  id                 String          @id @default(cuid())
  userId             String
  companyId          String
  status             String          @default("PENDING")
  trackingNumber     String?
  totalAmount        Float
  currency           String          @default("USD")
  billingAddress     String?
  billingCity        String?
  billingState       String?
  billingPostalCode  String?
  billingCountry     String?
  deliveryAddress    String?
  deliveryCity       String?
  deliveryState      String?
  deliveryPostalCode String?
  deliveryCountry    String?
  paymentBrand       String?
  paymentLast4       String?
  // Real charge-capture state, distinct from `status` above (which is
  // fulfillment/shipping). 'PENDING' | 'PAID' | 'PROCESSING' (ACH, settles in
  // days) | 'FAILED'. stripePaymentIntentId lets the webhook find this order
  // when Stripe confirms or fails the charge asynchronously.
  paymentStatus          String          @default("PENDING")
  stripePaymentIntentId  String?         @unique
  createdAt              DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              OrderItem[]
  documents          OrderDocument[]
  messages           OrderMessage[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

// A receipt/document attached to an order — either side can upload
// (uploadedByCompany distinguishes who, and gates who can delete it), both
// can see it. Uses the same Supabase Storage bucket as personal Files.
model OrderDocument {
  id                String   @id @default(cuid())
  orderId           String
  uploadedByCompany Boolean  @default(true)
  name              String
  size              Int
  mimeType          String
  storageKey        String   @unique
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// A flat message thread scoped to one order — the buyer and the selling
// company writing directly to each other about that specific purchase.
// Only these two exact parties exist in Order, so `senderIsCompany` alone
// is enough to attribute a message without extra relations.
model OrderMessage {
  id              String   @id @default(cuid())
  orderId         String
  senderIsCompany Boolean
  content         String
  createdAt       DateTime @default(now())
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

// A card saved for checkout — backed by a real Stripe PaymentMethod (created
// client-side via Stripe Elements, which never lets the raw card number
// touch our server). brand/last4/expiry are display metadata fetched back
// from Stripe after the PaymentMethod is created, not derived locally.
model SavedCard {
  id                    String   @id @default(cuid())
  userId                String
  stripePaymentMethodId String   @unique
  cardholderName        String
  brand                 String
  last4                 String
  expiry                String
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A bank account saved for checkout via ACH — backed by a real Stripe
// PaymentMethod (type "us_bank_account"), linked through Stripe Financial
// Connections. Distinct from BankConnection/BankAccount (the read-only
// Plaid data on the Finance page); this is specifically a payment method
// Stripe can actually debit.
model SavedBankAccount {
  id                    String   @id @default(cuid())
  userId                String
  stripePaymentMethodId String   @unique
  bankName              String?
  accountType           String? // 'checking' | 'savings'
  last4                 String
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedAddress {
  id            String   @id @default(cuid())
  userId        String
  label         String?
  fullName      String
  streetAddress String
  city          String?
  state         String?
  postalCode    String?
  country       String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Work Suite: a lightweight mini-ERP owned directly by the logged-in user
// (personal or company account alike) — projects, tasks, a CRM contact
// list, and invoicing, independent of the company-scoped Module/Page system.
model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([userId])
  @@index([status])
}

// Files: personal cloud storage — each row is metadata for one object
// uploaded to Supabase Storage (storageKey is the path within the bucket).
// folderId null means the file sits at the root of the user's Files.
model UserFile {
  id                String                 @id @default(cuid())
  userId            String
  folderId          String?
  connectionId      String?
  // Only meaningful when connectionId is set — a connection-scoped file can
  // be uploaded by either side, same as ConnectionMessage/OrderDocument.
  // userId still points at the connection's buyer either way, since the
  // company side has no personal Files/folders system of its own to own it.
  uploadedByCompany Boolean                @default(false)
  // Null for a regular personal file; 'CV_DOCUMENT' scopes it to the Jobs
  // page's private Documents section instead of the general Files list.
  category          String?
  name              String
  size              Int
  mimeType          String
  storageKey        String                 @unique
  createdAt         DateTime               @default(now())
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder            UserFolder?            @relation(fields: [folderId], references: [id], onDelete: Cascade)
  connection        UserCompanyConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([folderId])
  @@index([connectionId])
}

// A folder is just a grouping of files (and other folders) — parentId null
// means it sits at the root. Deleting a folder cascades to everything inside.
model UserFolder {
  id        String       @id @default(cuid())
  userId    String
  parentId  String?
  name      String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    UserFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  UserFolder[] @relation("FolderChildren")
  files     UserFile[]

  @@index([userId])
  @@index([parentId])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  description String?
  status      String    @default("TODO")
  priority    String    @default("MEDIUM")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

// A completed focus/pomodoro session — the real log behind the Work Suite
// Focus timer's session-count stat, replacing what used to be a
// localStorage-only per-day counter.
model FocusSession {
  id           String   @id @default(cuid())
  userId       String
  workMinutes  Int
  breakMinutes Int
  completedAt  DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([completedAt])
}

// A real person-to-person direct message — what the top-nav Inbox actually
// shows now, replacing what used to be a page with zero backend wiring.
model DirectMessage {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  fromUser   User     @relation("sentDirectMessages", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("receivedDirectMessages", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId])
  @@index([toUserId])
}

// A real notification record — surfaced in the navbar dropdown alongside the
// existing derived task/goal insights. Scoped to personal users only; a
// company's own inbox pages (client messages/tickets) already show unread
// state directly, so they don't need a parallel notification feed here.
model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  body        String?
  actionRoute String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

// Personal growth tracking — goals with progress, and a log of achievements.
// Scoped to userId like the rest of Work Suite, but this is the part of the
// mini-ERP aimed at individuals developing themselves rather than running a
// business (though nothing stops a company user from using it too).
model Goal {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String?
  status      String    @default("ACTIVE")
  progress    Int       @default(0)
  targetDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// A personal job-application tracker — the "Jobs" tab in Work Suite
// Planning. Deliberately separate from the site-wide Job model (company job
// postings) and Candidate model (a company's view of its applicants): this
// is the applicant's own private board of roles they're pursuing, scoped to
// userId like the rest of Work Suite.
model JobApplication {
  id          String    @id @default(cuid())
  userId      String
  company     String
  role        String
  status      String    @default("SAVED")
  url         String?
  notes       String?
  appliedDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// A private CV — separate from the public UserProfile, used only for job
// applications from the Jobs page. Experience/education/skills are stored
// as JSON arrays (same convention as Post.tags/mentions elsewhere in this
// schema) rather than child tables, since nothing else needs to query into
// them relationally.
model WorkProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  headline   String?
  summary    String?
  experience String   @default("[]")
  education  String   @default("[]")
  skills     String   @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A personal calendar entry on the Work Suite Calendar page — distinct from
// the site-wide Event model (public, RSVP'd, has attendees). This is a
// private note-to-self: a single-day timed event, a full-day event, or a
// multi-day span (endDate set). startTime/endTime only apply when
// allDay is false, since a multi-day event has no single start/end clock time.
model CalendarEvent {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean   @default(true)
  startTime   String?
  endTime     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Set only for events created from a table reservation — lets the
  // calendar UI know to show the "Automatic Check-In" option, which makes
  // no sense on an ordinary personal event with nothing to check into.
  tableReservationId String?           @unique
  tableReservation   TableReservation? @relation(fields: [tableReservationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([startDate])
}

// A personal income/expense tracker on the Work Suite Finance page — for a
// freelancer or job-seeker tracking money owed and spent, distinct from a
// company's real Billing/Transactions (GlobalPayment/CompanyInvoice), which
// already exist and stay untouched here.
model FinanceEntry {
  id          String   @id @default(cuid())
  userId      String
  type        String // 'INCOME' | 'EXPENSE'
  amount      Float
  description String
  category    String?
  status      String   @default("PAID") // 'PAID' | 'PENDING' — mainly meaningful for INCOME (invoices owed)
  date        DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([date])
}

// A manually-logged order or invoice on the Finance page — for purchases or
// bills from outside Ornave's own marketplace (a vendor invoice, a receipt
// from another store) that wouldn't otherwise show up anywhere. Distinct
// from the real Order model, which is Ornave marketplace checkout only.
model ManualOrder {
  id             String   @id @default(cuid())
  userId         String
  type           String // 'ORDER' | 'INVOICE'
  vendor         String
  description    String?
  amount         Float
  currency       String   @default("USD")
  status         String   @default("PENDING") // 'PENDING' | 'PAID' | 'CANCELLED'
  date           DateTime
  trackingNumber String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([date])
}

// A linked bank via Plaid — one row per Plaid "Item" (roughly, one bank
// login). accessToken is AES-256-GCM encrypted at rest (see utils/encryption)
// since it's effectively a credential to the user's real bank data.
model BankConnection {
  id              String        @id @default(cuid())
  userId          String
  itemId          String        @unique
  accessToken     String
  institutionName String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts        BankAccount[]

  @@index([userId])
}

// One row per account within a linked bank (checking, savings, credit card,
// ...). Balances are a snapshot refreshed on demand from Plaid, not synced
// continuously — good enough for a personal finance overview, not a ledger.
model BankAccount {
  id               String         @id @default(cuid())
  connectionId     String
  plaidAccountId   String         @unique
  name             String
  officialName     String?
  mask             String?
  type             String
  subtype          String?
  // AES-256-GCM encrypted (backend/src/utils/encryption.ts) — balances are
  // as sensitive as the Plaid accessToken itself and shouldn't be readable
  // by anyone with raw table access (e.g. the Supabase dashboard).
  currentBalance   String?
  availableBalance String?
  currency         String?
  // 'UNVERIFIED' (default — just linked, ownership unconfirmed beyond
  // Plaid's own Link auth) | 'VERIFIED' (Plaid Identity's account-holder
  // name matched this user's name) | 'FAILED' (checked, didn't match).
  // Gates features — like automatic reservation check-in — that need real
  // confirmation this account belongs to this person, not just that some
  // account got linked.
  verificationStatus String       @default("UNVERIFIED")
  verifiedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  connection       BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String?
  achievedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("NOTE") // NOTE | STICKY | MINDMAP
  title     String?
  content   String
  color     String? // sticky-note background color, or mind-map node accent color
  shape     String? // mind-map node shape: pill | rect | diamond | hexagon
  fontSize  String? // mind-map node text size: sm | md | lg
  posX      Float? // mind-map branch position, relative to the tree's center — null means "not manually placed, use auto layout"
  posY      Float?
  pinned    Boolean  @default(false)
  parentId  String? // MINDMAP branches point at the root/parent node they hang off
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Note?    @relation("NoteBranches", fields: [parentId], references: [id], onDelete: Cascade)
  children  Note[]   @relation("NoteBranches")

  @@index([userId])
  @@index([parentId])
}

model Event {
  id                  String      @id @default(cuid())
  authorId            String
  title               String
  description         String?
  detailedDescription String?
  coverImage          String?
  media               String      @default("[]")
  category            String?
  startAt             DateTime
  endAt               DateTime?
  isVirtual           Boolean     @default(false)
  location            String?
  mapUrl              String?
  externalLink        String?
  price               Float       @default(0)
  currency            String      @default("USD")
  capacity            Int?
  ticketProductId     String?
  isPromoted          Boolean     @default(false)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  author              User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ticketProduct       Product?    @relation(fields: [ticketProductId], references: [id], onDelete: SetNull)
  rsvps               EventRsvp[]
  saves               EventSave[]

  @@index([authorId])
  @@index([category])
  @@index([startAt])
  @@index([isPromoted])
}

model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("GOING")
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model EventSave {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// ============================================
// COMPANY ERP MODULES (Sales / Leads / Marketing / Learning / Talent / Billing)
// Every model below is strictly scoped to a single companyId. All access to
// these records must go through routes that verify req.user.companyId
// matches the :companyId route param (see companyContextMiddleware) — one
// company must never be able to read or write another company's ERP data.
// ============================================

model Deal {
  id            String    @id @default(cuid())
  companyId     String
  name          String
  clientCompany String?
  value         Float     @default(0)
  stage         String    @default("Prospect")
  owner         String?
  closeDate     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Lead {
  id                String   @id @default(cuid())
  companyId         String
  name              String
  title             String?
  leadCompany       String?
  location          String?
  industry          String?
  connections       Int      @default(0)
  mutualConnections String?
  saved             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Campaign {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  type        String   @default("Sponsored Content")
  status      String   @default("Draft")
  budget      Float    @default(0)
  spent       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Course {
  id         String   @id @default(cuid())
  companyId  String
  title      String
  instructor String?
  category   String?
  level      String   @default("Beginner")
  duration   String?
  rating     Float    @default(0)
  enrolled   Int      @default(0)
  progress   Int?
  saved      Boolean  @default(false)
  thumbnail  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Candidate {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  title        String?
  location     String?
  skills       String   @default("[]")
  experience   String?
  availability String   @default("Available")
  saved        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyInvoice {
  id          String   @id @default(cuid())
  companyId   String
  description String
  amount      Float
  status      String   @default("Pending")
  invoiceDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Append-only security audit trail for authentication events. Deliberately
// has no FK/cascade relation to User — an audit log should survive account
// deletion, not disappear with it.
model AuthAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  eventType String // 'REGISTER' | 'LOGIN_SUCCESS' | 'LOGIN_FAILED' | 'ACCOUNT_LOCKED' | 'PASSWORD_CHANGED'
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([eventType])
  @@index([createdAt])
}
