DATABASE_URL="postgresql://user:password@localhost:5432/ornave_db"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRY="7d"
NODE_ENV="development"
PORT=3000
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Work Suite Files — Supabase Storage (Settings -> API in the Supabase
# dashboard for the URL and the service_role secret key). Uploads fail
# without these; nothing else in the app depends on them.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Resend (resend.com) — sends the email-verification link on registration.
# Without a verified sending domain, RESEND_FROM must stay
# "onboarding@resend.dev" and Resend will only actually deliver to the
# account owner's own email; everything else silently fails (logged, not
# thrown) until a domain is verified in the Resend dashboard. Missing this
# var entirely falls back to console-logging the link instead of emailing it.
RESEND_API_KEY="re_your_api_key"
RESEND_FROM="Ornave <onboarding@resend.dev>"
