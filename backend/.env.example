DATABASE_URL="postgresql://user:password@localhost:5432/ornave_db"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRY="7d"
NODE_ENV="development"
PORT=3000
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Work Suite Files — Supabase Storage (Settings -> API in the Supabase
# dashboard for the URL and the service_role secret key). Uploads fail
# without these; nothing else in the app depends on them.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Resend (resend.com) — sends the email-verification link on registration.
# Without a verified sending domain, RESEND_FROM must stay
# "onboarding@resend.dev" and Resend will only actually deliver to the
# account owner's own email; everything else silently fails (logged, not
# thrown) until a domain is verified in the Resend dashboard. Missing this
# var entirely falls back to console-logging the link instead of emailing it.
RESEND_API_KEY="re_your_api_key"
RESEND_FROM="Ornave <onboarding@resend.dev>"

# Plaid (plaid.com) — powers "Connect Bank" on the Finance page. Get
# client_id and a Sandbox secret free from the Plaid dashboard (Team
# Settings > Keys); Sandbox connects to fake test banks only. Production
# needs Plaid's approval and a production secret. Currently configured for
# European institutions (GB/DE/FR/ES/NL/IE/IT) — most require the OAuth
# redirect leg below, not just these three vars.
PLAID_CLIENT_ID="your_plaid_client_id"
PLAID_SECRET="your_plaid_sandbox_secret"
PLAID_ENV="sandbox"

# Required for European/UK banks (PSD2 Open Banking) — they redirect the
# user to the bank's own login, then back here to finish Link. Must be
# added to "Allowed redirect URIs" in the Plaid dashboard (Team Settings >
# API) *exactly* matching this value, protocol included, before it'll work.
PLAID_REDIRECT_URI="http://localhost:5175/plaid-oauth-redirect"

# Encrypts Plaid access tokens at rest (AES-256-GCM) — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="64-char-hex-string"
